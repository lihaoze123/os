target := "riscv64gc-unknown-none-elf"
mode := "release"
app_dir := "src/bin"
target_dir := "target" / target / mode

objcopy := "rust-objcopy"
objdump := "rust-objdump"

base_address := "0x80400000"
step := "0x20000"
linker := "src/linker.ld"

default:
    @just --list

clean:
    @cargo clean

elf: clean
    #!/usr/bin/env python3
    import subprocess
    from pathlib import Path

    BASE_ADDRESS = {{ base_address }}
    STEP = {{ step }}
    LINKER = Path('{{ linker }}')

    if __name__ == '__main__':
        apps = Path('{{ app_dir }}')

        for id, app in enumerate(sorted(apps.iterdir())):
            app = app.stem
            addr = hex(BASE_ADDRESS + STEP * id)

            lines = LINKER.read_text()
            LINKER.write_text(
                lines.replace(hex(BASE_ADDRESS), addr)
            )

            subprocess.run(['cargo', 'build', '--bin', app, '--release'], check=True, )
            print(f'[build.py] application {app} start with address {addr}')

            LINKER.write_text(lines)

binary: elf
    #!/usr/bin/env python3
    import subprocess
    from pathlib import Path

    APP_DIR = Path("{{ app_dir }}")
    TARGET_DIR = Path("{{ target_dir }}")

    for source in sorted(APP_DIR.glob("*.rs")):
        elf = TARGET_DIR / source.stem
        subprocess.run(
            [
                "{{ objcopy }}",
                "--binary-architecture=riscv64",
                elf,
                "--strip-all",
                "-O",
                "binary",
                f"{elf}.bin",
            ],
            check=True,
        )

[positional-arguments]
disasm app="": elf
    #!/usr/bin/env python3
    import subprocess
    import sys
    from pathlib import Path

    APP_DIR = Path("{{ app_dir }}")
    TARGET_DIR = Path("{{ target_dir }}")

    app = sys.argv[1]
    sources = sorted(APP_DIR.glob("*.rs"))
    if not app:
        if len(sources) != 1:
            print("usage: just disasm <app>", file=sys.stderr)
            print("available apps:", file=sys.stderr)
            for source in sources:
                print(f"  {source.stem}", file=sys.stderr)
            raise SystemExit(2)
        app = sources[0].stem

    app = Path(app).name
    if app.endswith(".rs"):
        app = app[:-3]

    elf = TARGET_DIR / app
    if not elf.is_file():
        print(
            f"error: app '{app}' does not produce an ELF at '{elf}'",
            file=sys.stderr,
        )
        raise SystemExit(1)

    result = subprocess.run(
        [
            "{{ objdump }}",
            "--arch-name=riscv64",
            "--all-headers",
            "--disassemble",
            "--demangle",
            elf,
        ],
        check=True,
        stdout=subprocess.PIPE,
    )
    subprocess.run(["less"], input=result.stdout, check=True)

build: binary
